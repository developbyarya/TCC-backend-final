{
  "openapi": "3.0.0",
  "info": { "title": "TCC Backend API", "version": "1.0.0" },
  "paths": {
    "/health": { "get": { "responses": { "200": { "description": "OK" } } } },
    "/user/login": { "post": { "summary": "Log in", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "username": { "type": "string" }, "email": { "type": "string" }, "password": { "type": "string" } }, "required": ["password"] }, "example": { "username": "johndoe", "password": "s3cret" } } } }, "responses": { "200": { "description": "Tokens", "content": { "application/json": { "schema": { "type": "object", "properties": { "token": { "type": "string" }, "refreshToken": { "type": "string" } }, "example": { "token": "eyJhb...", "refreshToken": "eyJhb..." } } } }, "401": { "description": "Invalid credentials" } } } },
    "/user/register": { "post": { "summary": "Register", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "username": { "type": "string" }, "full_name": { "type": "string" }, "email": { "type": "string" }, "phone_number": { "type": "string" }, "password": { "type": "string" }, "role": { "type": "string" }, "alt_name": { "type": "string" } }, "required": ["username","email","password"] }, "example": { "username": "johndoe", "full_name": "John Doe", "email": "john@example.com", "password": "s3cret", "role": "USER" } } } }, "responses": { "201": { "description": "Created", "content": { "application/json": { "example": { "id": "user_abc123" } } } }, "400": { "description": "Bad request" } } } },
    "/karya-seni/create": { "post": { "summary": "Create artwork", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "nama_karya": { "type": "string" }, "deskripsi": { "type": "string" }, "katalog": { "type": "string" }, "tags": { "type": "string" }, "min_bid_ammount": { "type": "number" }, "open_bid_time": { "type": "string" }, "close_bid_time": { "type": "string" } }, "required": ["nama_karya"] }, "example": { "nama_karya": "Matahari", "deskripsi": "Lukisan abstrak.", "katalog": "Modern", "tags": "abstrak,modern", "min_bid_ammount": 100 } } } }, "responses": { "201": { "description": "Created", "content": { "application/json": { "example": { "id": "art_abc123", "nama_karya": "Matahari" } } } } } } },
    "/karya-seni/{id}": { "get": { "summary": "Get artwork by id", "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ], "responses": { "200": { "description": "Artwork", "content": { "application/json": { "example": { "id": "art_abc123", "nama_karya": "Matahari", "deskripsi": "Lukisan abstrak." } } } }, "404": { "description": "Not found" } } } }
}
